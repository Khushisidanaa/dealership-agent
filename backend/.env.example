# MongoDB (local or Atlas)
# Local:
# MONGODB_URL=mongodb://localhost:27017
# Atlas: replace <db_password> with your actual password (URL-encode special chars)
# MONGODB_URL=mongodb+srv://dbUser:<db_password>@cluster0.cdvas.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=dealership_agent

# Chat / LLM: Amazon Bedrock (DeepSeek) — requirements extraction, summaries, rankings
# Uses same AWS credentials as Nova Act (ACCESS_KEY / SECRET_ACCRESS_KEY below)
BEDROCK_CHAT_MODEL_ID=deepseek.v3.2
BEDROCK_REGION=us-east-1

# Twilio (voice script + SMS/calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Voice agent: Amazon Nova Sonic (preferred) or Deepgram
# Nova Sonic uses same AWS credentials as Nova Act (ACCESS_KEY / SECRET_ACCRESS_KEY below)
# Optional: hackathon key from organizers
# AWS_KEY=your-hackathon-key
# Nova Sonic model (default amazon.nova-sonic-v1:0)
# NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0
# NOVA_SONIC_REGION=us-east-1
# Deepgram (fallback when Nova Sonic not configured)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Car search: "nova_act" (AWS Nova/Bedrock) or "marketcheck"
# Use nova_act to stay on AWS; results cached 30 min to respect rate limits (e.g. 5000 RPD)
CAR_SEARCH_PROVIDER=nova_act

# AWS credentials for Nova Act / Bedrock (use ACCESS_KEY/SECRET_ACCRESS_KEY or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
ACCESS_KEY=your-aws-access-key-id
SECRET_ACCRESS_KEY=your-aws-secret-access-key
# Nova Act API key (from nova.amazon.com/dev — hackathon / dev; used as NOVA_ACT_API_KEY for SDK)
# With this set, Nova Act car search is considered configured even without AWS credentials in .env
AWS_NOVA_HACKATHON_API_KEY=

# Nova Act workflow (required for REAL dealer/listings data; otherwise backend uses synthetic/fake data)
# You must deploy a workflow (browser automation) to AWS, then set:
# NOVA_ACT_WORKFLOW_NAME=your-workflow-definition-name
# NOVA_ACT_RESULT_S3_BUCKET=bucket-where-workflow-writes-result-json
# NOVA_ACT_RESULT_S3_PREFIX=optional/prefix
# If these are unset, car search uses Bedrock-only (fake listings).
# NOVA_ACT_WORKFLOW_NAME=car-search-workflow
# NOVA_ACT_MODEL_ID=us.amazon.nova-2-lite-v1:0
# NOVA_ACT_REGION=us-east-1
# NOVA_ACT_RESULT_S3_BUCKET=
# NOVA_ACT_RESULT_S3_PREFIX=

# MarketCheck (vehicle listings; fallback when Nova Act returns no results)
MARKETCHECK_API_KEY=your-marketcheck-api-key

# Google Maps (Geocoding + Places API for dealership search)
GOOGLE_MAPS_API_KEY=

# Dashboard PDF export uses Bedrock (DeepSeek) + reportlab; no Foxit needed for that.
# Foxit PDF Services (optional: document extraction / Carfax, etc.)
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=your-client-id
FOXIT_CLIENT_SECRET=your-client-secret

# Server / Voice script
# Public URL for Twilio webhooks (e.g. https://xxx.ngrok-free.dev — no trailing slash) for local development
# Needs to be replaced with the public URL of the server when deployed
SERVER_BASE_URL=https://your-subdomain.ngrok-free.dev
# Optional: number to call when voice script starts (e.g. +15551234567)
TO_NUMBER=+15551234567
# Port the voice script server listens on
PORT=8000
