# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=dealership_agent

# Chat / LLM: Amazon Bedrock (DeepSeek) — requirements extraction, summaries, rankings
# Uses same AWS credentials as Nova Act (ACCESS_KEY / SECRET_ACCRESS_KEY or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
BEDROCK_CHAT_MODEL_ID=deepseek.v3.2
BEDROCK_REGION=us-east-1

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Deepgram
DEEPGRAM_API_KEY=your-deepgram-key

# Foxit PDF Services
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=your-client-id
FOXIT_CLIENT_SECRET=your-client-secret

# Server
SERVER_BASE_URL=http://localhost:8000
